// Scrape job for the manifests repo's apps/alloy.yaml — paste this inside the
// existing `alloy: configMap: content: |` block, beside prometheus.scrape
// "kubelet" and friends.
//
// It does NOT belong in this repository to be deployed from: Argo CD reconciles
// `manifests`, so that is the only place a change here takes effect. This file
// is the source of truth for the text; copying it across is a deliberate step.
//
// Hosts are listed statically because there are two of them and they do not
// come and go. Service discovery for a two-row list is machinery with nothing
// to discover.
//
// NOTE, and it is the reason this is a snippet rather than a patch: Alloy runs
// as a DaemonSet here. A static target is therefore scraped by EVERY Alloy pod.
// With one node that is exactly one scrape and harmless. With two it is
// duplicate series, distinguishable only by the pod that produced them. Before
// adding a node, either move this to a single-replica Alloy Deployment for
// external targets, or enable the chart's clustering.

// NOTE the label is host_role, not role. A target label collides
// with a metric label of the same name, and the metric's loses:
// Prometheus renames it to exported_role (honor_labels is false by
// default). arakyd emits role="cpu"/"igpu"/"nvme" on its
// temperature series and was there first, so the TARGET label is
// the one that had to move. Symptom was a temperature panel
// returning zero series while the data was present all along.
prometheus.scrape "hosts" {
  targets = [
    // corelia: the workstation, and the machine with the cores and
    // the models. Manually managed — deliberately outside Ansible's
    // scope — so treat its absence as normal rather than as an
    // incident. arakyd_* series come from its textfile collector.
    {
      "__address__" = "192.168.3.46:9100",
      "instance"    = "corelia",
      "host_role"   = "workstation",
    },
    // meksha: this node. Its being down IS an incident.
    {
      "__address__" = "192.168.3.52:9100",
      "instance"    = "meksha",
      "host_role"   = "server",
    },
  ]

  // Declared, not inherited. With job_name unset, `job` defaults to
  // the component's full name (prometheus.scrape.hosts), so a query
  // filtering job="hosts" silently returns no series. Nothing else in
  // this file sets it, which means there is no local convention to
  // follow — so it is stated.
  job_name = "hosts"

  // 30s matches arakyd's timer on corelia. Scraping faster than the
  // textfile is rewritten yields repeated samples of one reading,
  // which looks like data and is not.
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.remote_write.mimir.receiver]
}
