# Writes the readings node_exporter cannot take into the textfile directory it
# serves. Oneshot: run by arakyd-collector.timer, not long-lived.
#
# Needs no root — everything it reads is world-readable sysfs — so it runs in
# the user scope alongside the exporter.
[Unit]
Description=arakyd — collect Strix Halo readings for node_exporter's textfile collector
Documentation=https://github.com/malahmen/arakyd

[Service]
Type=oneshot
# StateDirectory= creates %S/arakyd (~/.local/state/arakyd) before the
# sandbox is set up, and makes it the one writable path in it. The previous
# `ExecStartPre=mkdir -p` could not: a ReadWritePaths= naming a missing
# directory fails the namespace setup (226/NAMESPACE) before any Exec runs
# (Kamino item 131).
StateDirectory=arakyd
# %h/.local/bin is on a user's PATH on Fedora/bazzite by default.
ExecStart=%h/.local/bin/arakyd.sh --write %S/arakyd
# A sysfs read can hang in D state (amdgpu has done it); a oneshot that never
# finishes is never started again by its timer. 20 s is far past a normal run.
TimeoutStartSec=20s
# Hardening: it reads sysfs and writes one file. It needs nothing else.
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
