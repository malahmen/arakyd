# Writes the readings node_exporter cannot take into the textfile directory it
# serves. Oneshot: run by arakyd-collector.timer, not long-lived.
#
# Needs no root — everything it reads is world-readable sysfs — so it runs in
# the user scope alongside the exporter.
[Unit]
Description=arakyd — collect Strix Halo readings for node_exporter's textfile collector
Documentation=https://github.com/malahmen/arakyd

[Service]
Type=oneshot
# %h/.local/bin is on a user's PATH on Fedora/bazzite by default.
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/arakyd
ExecStart=%h/.local/bin/arakyd.sh --write %h/.local/state/arakyd
# Hardening: it reads sysfs and writes one file. It needs nothing else.
PrivateNetwork=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/arakyd
ProtectHome=read-only
NoNewPrivileges=true
